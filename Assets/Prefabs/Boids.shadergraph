{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "562ff52d4f54428db154ee6d5092ddcd",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetInstanceColor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -671.9999389648438,
            "y": 71.0,
            "width": 253.99996948242188,
            "height": 277.9999694824219
        }
    },
    "m_Slots": [
        {
            "m_Id": "c4f4d2c017cc40689b446a08a8162895"
        },
        {
            "m_Id": "042e5bb34e13450998851386659e288c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetInstanceColor",
    "m_FunctionSource": "0847a17317a6402a9c9e0f251f87b737",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "// Custom Function for Shader Graph\r\n// This function reads instance colors from a structured buffer\r\n\r\n// Define the structured buffer (add this to your shader properties)\r\nStructuredBuffer<float4> _InstanceColorBuffer;\r\n\r\nvoid GetInstanceColor_float(float InstanceID, out float4 Color)\r\n{\r\n    #if defined(UNITY_PROCEDURAL_INSTANCING_ENABLED)\r\n        // Get the instance ID from Unity's instancing\r\n        uint id = unity_InstanceID;\r\n        \r\n        // Read color from the buffer\r\n        Color = _InstanceColorBuffer[id];\r\n    #else\r\n        // Fallback color when instancing is not enabled\r\n        Color = float4(1, 1, 1, 1);\r\n    #endif\r\n}\r\n\r\nvoid GetInstanceColor_half(half InstanceID, out half4 Color)\r\n{\r\n    #if defined(UNITY_PROCEDURAL_INSTANCING_ENABLED)\r\n        uint id = unity_InstanceID;\r\n        Color = (half4)_InstanceColorBuffer[id];\r\n    #else\r\n        Color = half4(1, 1, 1, 1);\r\n    #endif\r\n}\r\n\r\n// Alternative version with buffer size validation\r\nvoid GetInstanceColorSafe_float(float InstanceID, float BufferSize, out float4 Color)\r\n{\r\n    #if defined(UNITY_PROCEDURAL_INSTANCING_ENABLED)\r\n        uint id = unity_InstanceID;\r\n        \r\n        // Clamp to buffer size to prevent out of bounds access\r\n        id = min(id, (uint)BufferSize - 1);\r\n        \r\n        Color = _InstanceColorBuffer[id];\r\n    #else\r\n        Color = float4(1, 1, 1, 1);\r\n    #endif\r\n}\r\n\r\nvoid GetInstanceColorSafe_half(half InstanceID, half BufferSize, out half4 Color)\r\n{\r\n    #if defined(UNITY_PROCEDURAL_INSTANCING_ENABLED)\r\n        uint id = unity_InstanceID;\r\n        id = min(id, (uint)BufferSize - 1);\r\n        Color = (half4)_InstanceColorBuffer[id];\r\n    #else\r\n        Color = half4(1, 1, 1, 1);\r\n    #endif\r\n}"
}

